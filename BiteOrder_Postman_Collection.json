          "name": "Register (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set(\"userToken\", j.token); }",
                  "pm.test(\"status is 2xx\", () => pm.response.to.be.success);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"demo.user@biteorder.com\",\n  \"password\": \"Demo@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
