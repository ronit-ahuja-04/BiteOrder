PORT=5001
# MongoDB Atlas connection string (replace <username>, <password>, <cluster>)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/biteorder?retryWrites=true&w=majority

# JWT (Experiment 6)
JWT_SECRET=replace_with_a_long_random_string

JWT_EXPIRES_IN=1d

# Admin bootstrap (account is auto-created on server start)
ADMIN_NAME=BiteOrder Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose_a_strong_password
